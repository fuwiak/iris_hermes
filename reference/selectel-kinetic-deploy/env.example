# --- AI-агент (активен) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# --- Мой Склад (Remap 1.2 API) ---
MOYSKLAD_API_TOKEN=
MOYSKLAD_API_URL=https://api.moysklad.ru/api/remap/1.2
MOYSKLAD_ENABLED=false
MOYSKLAD_SYNC_LIMIT=0
MOYSKLAD_SYNC_ORDERS_LIMIT=0
MOYSKLAD_AUTO_SYNC=true

# --- 1С (placeholder) ---
ONEC_ENABLED=false
ONEC_ODATA_URL=

# --- Мессенджеры ---
MESSENGER_ENABLED=false

# --- Green API (WhatsApp) ---
GREEN_API_ENABLED=false
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_URL=https://api.green-api.com
GREEN_API_MEDIA_URL=https://media.green-api.com

# --- Telegram Bot API (рассылки /campaigns) ---
# Клиент должен хотя бы раз написать боту, либо иметь @ник в карточке.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=my_veresk_bot
TELEGRAM_API_TIMEOUT_SECONDS=10
TELEGRAM_SYNC_ON_ATTACH=false
# Канал для постов: @channel_username или числовой id (-100…)
# Бот должен быть администратором канала с правом публикации.
TELEGRAM_CHANNEL_ID=

# --- Логин в CRM ---
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
AUTH_SECRET_KEY=iris-crm-session-secret

# --- Обогащение из мессенджеров ---
ENRICHMENT_CHAT_LIMIT=50
ENRICHMENT_BATCH_SIZE=5
ENRICHMENT_CONCURRENCY=3
MESSENGER_LIVE_FETCH=false

# --- Rate limit / retry для внешних API ---
MOYSKLAD_POSITIONS_CONCURRENCY=2
MOYSKLAD_API_RETRY_MAX=4
MOYSKLAD_REQUEST_DELAY_MS=250
GREEN_API_CONCURRENCY=1
GREEN_API_RETRY_MAX=4

# --- Telegram Data Export (result.json; на проде лучше .json.gz) ---
TELEGRAM_EXPORT_PATH=data/telegram_export.json
TELEGRAM_EXPORT_AUTO_IMPORT=true
TELEGRAM_EXPORT_MAX_MB=50

# --- AI lazy-сегментация в фоне (WebSocket push на /clients) ---
AI_AUTO_SEGMENT=true
AI_LAZY_BATCH_SIZE=5

# --- Хранилище: memory | postgres ---
# --- Postgres (на Selectel: docker-compose задаёт DATABASE_URL сам) ---
REPOSITORY_BACKEND=memory
DATABASE_URL=
DB_PERSIST_ENABLED=false

# --- Redis (на Selectel: docker-compose задаёт REDIS_URL сам) ---
REDIS_URL=
CACHE_TTL_SECONDS=86400

# --- Warm cache / keep-alive (локально / legacy) ---
WARM_CACHE_ON_STARTUP=true
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_SECONDS=300

# Postgres → hub кусками (live /clients)
DB_LOAD_CHUNK_SIZE=500
DB_LOAD_FIRST_CHUNK_WAIT_MS=2500

# --- Модули CRM ---
LEADS_ENABLED=false
CAMPAIGNS_ENABLED=true

# --- Selectel (DNS / API) ---
# Панель → Доступ → API-ключи (статический X-Token)
SELECTEL_API_KEY=
# Панель → Доступ → Сервисные пользователи (IAM)
SELECTEL_SERVICE_USER=
SELECTEL_SERVICE_USER_ID=
SELECTEL_SERVICE_PASSWORD=
SELECTEL_ACCOUNT_ID=
# Имя облачного проекта с DNS hosting (actual) — нужно для zones API
SELECTEL_PROJECT_NAME=
