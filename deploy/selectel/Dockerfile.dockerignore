# Dockerignore for deploy/selectel/Dockerfile (BuildKit).

.git
.gitignore
.gitmodules
.github
.cursor
.agents
.claude
.plans
.vscode
.idea

__pycache__
*.py[cod]
.Python
*.egg-info/
# Keep plugin dashboard UI bundles (MoySklad Клиенты) — bare `dist/` would drop them.
dist/
!plugins/*/dashboard/dist/
!plugins/*/dashboard/dist/**
!plugins/**/dashboard/dist/
!plugins/**/dashboard/dist/**
build/
.pytest_cache/
.coverage
htmlcov/
.venv
**/.venv
venv/
env/
ENV/
node_modules
**/node_modules
.pip-cache/
.uv-cache/
.notebooklm-cli-venv/
.notebooklm-playwright/

.env
.env.*
!.env.example

# Heavy / unused for dashboard-only Railway image
tests/
website/
docs/
plans/
.plans/
nix/
flake.nix
flake.lock
packaging/
assets/
infographic/
graphify-out/
reference/
ui-tui/
# apps/desktop needed — web vite aliases @desktop into it
apps/electron/
**/*.md
!README.md
!LICENSE

# Keep prebuilt web UI in context
!hermes_cli/web_dist/
!hermes_cli/web_dist/**

data/
.hermes-docker/
.notebooklm-home/
hermes-config/
runtime/

# Root production Dockerfile not needed in this image
Dockerfile
.dockerignore
