# Selectel / Iris Hermes deploy secrets (copy to /root/deploy.env on VDS)
# Never commit real values.

# --- Postgres (compose injects DATABASE_URL) ---
POSTGRES_PASSWORD=change-me-strong

# --- Hermes / dashboard ---
# Copy relevant keys from Railway `railway variable list --kv`
# or from local ~/.hermes/.env

MOYSKLAD_API_TOKEN=
MOYSKLAD_API_URL=https://api.moysklad.ru/api/remap/1.2
MOYSKLAD_ENABLED=true
MOYSKLAD_AUTO_SYNC=true

# Telegram Business bot for Рассылки (sendMessage). Not committed — set on VDS.
# MOYSKLAD_TELEGRAM_BOT_TOKEN=
# MOYSKLAD_TELEGRAM_BOT_USERNAME=BoberSystemsAssistant_bot
# MOYSKLAD_TELEGRAM_BUSINESS_CONNECTION_ID=

# Personal Telegram (MTProto) for «мои контакты» — server-side so UI only asks
# phone + code (+ 2FA). From my.telegram.org → API development tools.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

OPENROUTER_API_KEY=
# Default chat model is deepseek/deepseek-v4-flash-0731 (· Med) via config.yaml.
# OPENROUTER_MODEL is optional override; prefer config model.default.
# If OpenRouter returns HTTP 403 "Access denied by security policy":
#   - often RU/Selectel egress IP — set OPENROUTER_BASE_URL to Railway egress
#     (see deploy/openrouter-egress/README.md), secret SELECTEL_IRIS_OPENROUTER_BASE_URL
#   - or rotate key / GitHub secret SELECTEL_IRIS_OPENROUTER_API_KEY
#   - recreate hermes container (entrypoint syncs into volume .env)
#   - or set DEEPSEEK_API_KEY and switch provider with `hermes model`
# OPENROUTER_BASE_URL=https://<railway-egress>/t/<EGRESS_TOKEN>/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# DEEPSEEK_API_KEY=

# Optional dashboard auth
# AUTH_ENABLED=true
# AUTH_USERNAME=admin
# AUTH_PASSWORD=
# AUTH_SECRET_KEY=
