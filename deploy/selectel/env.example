# Selectel / Iris Hermes deploy secrets (copy to /root/deploy.env on VDS)
# Never commit real values.

# --- Postgres (compose injects DATABASE_URL) ---
POSTGRES_PASSWORD=change-me-strong

# --- Hermes / dashboard ---
# Copy relevant keys from Railway `railway variable list --kv`
# or from local ~/.hermes/.env

MOYSKLAD_API_TOKEN=
MOYSKLAD_API_URL=https://api.moysklad.ru/api/remap/1.2
MOYSKLAD_ENABLED=true
MOYSKLAD_AUTO_SYNC=true

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Optional dashboard auth
# AUTH_ENABLED=true
# AUTH_USERNAME=admin
# AUTH_PASSWORD=
# AUTH_SECRET_KEY=
